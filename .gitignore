# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Maintained Vite plugin and worker sources.
!/build/
/build/*
!/build/connector-preview-plugin.mjs
!/build/connector-preview-worker.mjs
!/build/sites-vite-plugin.LICENSE
!/build/sites-vite-plugin.ts
!/build/sites-worker.ts

/dist/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/

# Offline desktop dependencies, builds and isolated test data.
/desktop/node_modules/
/desktop/release/
/desktop/generated/
/desktop/renderer-dist/
/desktop/tests/.acceptance-data/
/desktop/tests/.backup-data/
/desktop/tests/.test-data/
/desktop/tests/.backup-acceptance/
/desktop/tests/.lan-data/
/desktop/tests/.network-workspace-data/
/desktop/tests/.extended-data/
/*.exe
/mobile/node_modules/
/mobile/dist/
/mobile/android/.gradle/
/mobile/android/local.properties
/mobile/android/app/build/
/mobile/ios/App/Pods/
/mobile/ios/App/build/
/mobile/signing/
/mobile/android/app/src/main/assets/public/
/mobile/ios/App/App/public/
/*.apk

# Local business databases and SQLite sidecars; never commit live data.
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# Credentials, signing material and local environment configuration.
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_ed25519
credentials.json
secrets.json
.dev.vars
.dev.vars.*

# Dependencies and generated bundles in nested applications.
node_modules/
dist/
coverage/
.next/
*.exe
*.apk
*.aab
*.ipa
*.zip
*.zip.sha256.txt

# Keep local release bundles and historical delivery copies outside source control.
*.asar
/更新补丁-*/
/鑫金源珠宝-*/
/员工无F盘修复补丁-*/
/交付检查版-*/
/手机端安装包校验.json
